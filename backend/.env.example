DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"
PORT=3001
NODE_ENV=development

# Single production frontend URL (recommended)
FRONTEND_URL="https://your-project.pages.dev"

# Optional: comma-separated allowlist when you have multiple frontend domains
# FRONTEND_URLS="https://your-project.pages.dev,https://www.yourdomain.com"

JWT_SECRET="replace-with-a-long-random-secret"
OPENAI_API_KEY=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
REMINDER_WORKER_ENABLED=true
INTERNAL_DISPATCH_SECRET=""

# EzReply Agent Approval Orchestration
TELEGRAM_BOT_TOKEN=""
TELEGRAM_APPROVER_CHAT_ID=""
EZR_STAGING_URL=""
EZR_WHATSAPP_TEMPLATE_TOKEN=""
EZR_PHONE_NUMBER_ID=""
EZR_WABA_ID=""
EZR_TEST_PHONE=""
EZR_DEPLOY_FE_TARGET="cloudflare"
EZR_DEPLOY_BE_TARGET="render"

# Optional: custom persistence path for orchestration state (defaults to ./data/ezr-workflow-state.json)
# EZR_WORKFLOW_STATE_PATH="./data/ezr-workflow-state.json"
